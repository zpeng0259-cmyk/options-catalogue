---
interface Props {
  href: string;
  shortName: string;
  fullName: string;
  direction: '看涨' | '看跌' | '中性';
  riskCapped: boolean;
  capital: string;
  bestFor: string;
}
const { href, shortName, fullName, direction, riskCapped, capital, bestFor } = Astro.props;

const dirColor = {
  看涨: 'text-emerald-400 border-emerald-700/50',
  中性: 'text-amber-300 border-amber-700/50',
  看跌: 'text-red-400 border-red-700/50',
}[direction];

const dirIcon = { 看涨: '📈', 中性: '➡️', 看跌: '📉' }[direction];
---

<a
  href={href}
  class="block rounded-xl border border-zinc-700 bg-zinc-800/40 p-6 hover:border-amber-400 hover:bg-zinc-800 transition"
>
  <div class="flex items-baseline justify-between mb-2">
    <h3 class="text-2xl font-bold text-zinc-50">{shortName}</h3>
    <span class={`text-xs px-2 py-0.5 rounded border ${dirColor}`}>
      {dirIcon} {direction}
    </span>
  </div>
  <p class="text-sm text-zinc-400 mb-4">{fullName}</p>
  <dl class="space-y-2 text-sm">
    <div class="flex justify-between">
      <dt class="text-zinc-500">风险</dt>
      <dd class={riskCapped ? 'text-emerald-400' : 'text-zinc-200'}>
        {riskCapped ? '定义损失上限' : '未对冲'}
      </dd>
    </div>
    <div class="flex justify-between">
      <dt class="text-zinc-500">资金</dt>
      <dd class="text-zinc-200">{capital}</dd>
    </div>
    <div>
      <dt class="text-zinc-500 mb-1">最适合</dt>
      <dd class="text-zinc-200">{bestFor}</dd>
    </div>
  </dl>
  <p class="mt-4 text-xs text-amber-300">查看详情 →</p>
</a>

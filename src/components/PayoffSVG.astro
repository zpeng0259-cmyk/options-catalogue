---
interface Props {
  strategy: 'csp' | 'bps' | 'cc';
  caption?: string;
}
const { strategy, caption } = Astro.props;
const src = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/payoffs/${strategy}.svg`;
---

<figure class="my-6 not-prose">
  <div class="rounded-lg border border-zinc-700 bg-zinc-900 p-4">
    <img src={src} alt={`${strategy.toUpperCase()} payoff diagram`} class="w-full h-auto" />
  </div>
  {caption && <figcaption class="text-xs text-zinc-500 text-center mt-2">{caption}</figcaption>}
</figure>

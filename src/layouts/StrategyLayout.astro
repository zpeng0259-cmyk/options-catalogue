---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  shortName: string;
  fullName: string;
  oneLiner: string;
}
const { title, shortName, fullName, oneLiner } = Astro.props;
---

<BaseLayout title={title}>
  <header class="mb-8 pb-6 border-b border-zinc-800">
    <p class="text-sm text-zinc-500 mb-1">{fullName}</p>
    <h1 class="text-4xl font-bold text-zinc-50 mb-3">{shortName}</h1>
    <p class="text-lg text-zinc-300">{oneLiner}</p>
  </header>
  <article class="prose prose-lg prose-invert max-w-none">
    <slot />
  </article>
</BaseLayout>
